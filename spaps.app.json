{
  "name": "DogSwipe",
  "slug": "dogswipe",
  "template": "ios-fastapi",
  "spaps": {
    "local": {
      "api_url": "http://localhost:3301",
      "docs_url": "http://localhost:3301/docs",
      "local_mode_active": true
    },
    "production": {
      "api_url": "https://api.sweetpotato.dev",
      "application_slug": "dogswipe"
    },
    "application": {
      "id": null,
      "slug": "dogswipe",
      "blueprint_key": "native_mobile_auth",
      "provisioning_status": "public_descriptor",
      "application_id_env": "SPAPS_APPLICATION_ID",
      "server_secret_key_env": "SPAPS_API_KEY",
      "publishable_key_env": "DOGSWIPE_RELEASE_SPAPS_PUBLISHABLE_KEY"
    },
    "auth": {
      "native_redirect_url": "dogswipe://auth",
      "universal_link_redirect_url_env": "DOGSWIPE_RELEASE_AUTH_REDIRECT_URL",
      "universal_link_hosts_env": "DOGSWIPE_RELEASE_AUTH_UNIVERSAL_LINK_HOSTS",
      "aasa_paths": [
        "/auth",
        "/auth/callback"
      ]
    }
  }
}
