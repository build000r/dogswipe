## chart erd Barter Credit ERD
```mermaid
erDiagram
  IDENTITY ||--o| CREDIT_ACCOUNTS : owns
  IDENTITY ||--o{ CREDIT_LEDGER : has_entries
  IDENTITY ||--o{ HOTDOG_PROFILES : owns_offerings
  IDENTITY ||--o{ ORDERS : claims
  IDENTITY ||--o{ REVIEWS : rates
  IDENTITY ||--o{ REVIEWS : receives
  HOTDOG_PROFILES ||--o{ OFFERING_ADD_ONS : defines
  HOTDOG_PROFILES ||--o{ ORDERS : snapshots
  ORDERS ||--o{ CREDIT_LEDGER : spend_earn_refund_refs
  ORDERS ||--o{ REVIEWS : receives_two_directions

  IDENTITY {
    string user_id
  }
  CREDIT_ACCOUNTS {
    string user_id PK
    int lifetime_purchased
    int lifetime_earned
    int lifetime_spent
    datetime created_at
    datetime updated_at
  }
  CREDIT_LEDGER {
    string id PK
    string user_id
    string entry_type
    int amount
    int balance_after
    string order_ref
    string purchase_ref
    string idempotency_key UK
    text reason
    datetime created_at
  }
  HOTDOG_PROFILES {
    string id PK
    string category
    text tags_json
    int credit_cost
    string vendor_owner_user_id
    string fulfillment_mode
    datetime available_from
    datetime available_until
    float delivery_radius_miles
  }
  OFFERING_ADD_ONS {
    string id PK
    string profile_id FK
    string name
    int credit_cost
    datetime created_at
  }
  ORDERS {
    string id PK
    string user_id
    string profile_id
    int base_credit_cost
    text add_ons_json
    int total_credits
    string status
    datetime maker_ready_confirmed_at
    datetime maker_handoff_confirmed_at
    datetime claimer_handoff_confirmed_at
    datetime disputed_at
    datetime dispute_resolved_at
  }
  REVIEWS {
    string id PK
    string order_id
    string rater_user_id
    string ratee_user_id
    string direction UK
    int rating
    text text
    datetime created_at
  }
```
