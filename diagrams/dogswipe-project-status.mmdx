## chart erd DogSwipe Data Model
```mermaid
erDiagram
  HOTDOG_PROFILES ||--o{ OFFERING_ADD_ONS : "profile_id FK"
  HOTDOG_PROFILES ||--o{ SWIPE_EVENTS : "profile_id (logical)"
  HOTDOG_PROFILES ||--o{ ORDER_ITEMS : "profile_id (logical)"
  CREDIT_ACCOUNTS ||--o{ CREDIT_LEDGER : "user_id (logical)"
  CREDIT_ACCOUNTS ||--o{ ORDER_ITEMS : "user_id (logical)"
  ORDER_ITEMS ||--o{ CREDIT_LEDGER : "order_ref (logical)"
  ORDER_ITEMS ||--o{ REVIEWS : "order_id (logical)"
  CREDIT_ACCOUNTS ||--o| USER_PREFERENCES : "user_id (logical)"

  HOTDOG_PROFILES {
    string id PK
    string name
    string category
    int credit_cost
    float latitude
    float longitude
    string vendor_owner_user_id
    string availability_status
    float crave_score
  }
  OFFERING_ADD_ONS {
    string id PK
    string profile_id FK
    string name
    int credit_cost
  }
  SWIPE_EVENTS {
    string id PK
    string user_id
    string profile_id
    string decision
  }
  USER_PREFERENCES {
    string user_id PK
    float max_distance_miles
    bool spicy_friendly
    bool classic_only
  }
  CREDIT_ACCOUNTS {
    string user_id PK
    int lifetime_purchased
    int lifetime_earned
    int lifetime_spent
  }
  CREDIT_LEDGER {
    string id PK
    string user_id
    string entry_type
    int amount
    int balance_after
    string order_ref
    string idempotency_key
  }
  ORDER_ITEMS {
    string id PK
    string user_id
    string profile_id
    int total_credits
    string status
    datetime maker_handoff_confirmed_at
    datetime claimer_handoff_confirmed_at
    datetime disputed_at
  }
  REVIEWS {
    string id PK
    string order_id
    string rater_user_id
    string ratee_user_id
    string direction
    int rating
  }
```

