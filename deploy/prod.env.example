ENV=production
DEVELOPMENT_ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@postgres:5432/dogswipe
REDIS_URL=redis://redis:6379/0
CORS_ALLOW_ORIGINS=https://example.com
SPAPS_AUTH_ENABLED=true
SPAPS_API_URL=https://api.sweetpotato.dev
SPAPS_API_KEY=replace-me
SPAPS_APPLICATION_ID=replace-me
DOGSWIPE_AUTO_CREATE_SCHEMA=false
DOGSWIPE_SEED_SAMPLE_PROFILES=false
