## chart main DogSwipe Delivery Stack
```mermaid
flowchart LR
  user["iOS user"]
  ios["SwiftUI app"]
  authclient["SPAPSAuthClient"]
  deeplink["dogswipe://auth"]
  pubkey["SPAPS publishable key"]
  keychain["Keychain access token"]
  refresh["Keychain refresh token"]
  vm["View models"]
  core["DogSwipeCore package"]
  client["DogSwipeAPIClient"]
  profiles["HotdogProfile contract"]
  maps["Apple Maps handoff"]
  walk["Walking ETA"]
  preferences["CravingPreferences contract"]
  vendor["VendorSubmission contract"]
  menu["MenuSnapshot contract"]
  admin["AdminReview contract"]
  api["FastAPI backend"]
  worker["Menu refresh worker"]
  principal["Principal resolver"]
  migrations["Alembic migrations"]
  deploy["Deploy contract"]
  db["PostgreSQL"]
  spaps["SPAPS auth"]
  gates["Quality Gates"]

  user --> ios
  ios --> authclient
  ios --> deeplink
  pubkey --> authclient
  authclient --> spaps
  ios --> keychain
  ios --> refresh
  ios --> vm
  vm --> core
  vm --> client
  core --> profiles
