  core --> walk
  core --> preferences
  core --> vendor
  core --> menu
  core --> admin
  client --> api
  keychain --> client
  api --> profiles
  api --> preferences
  api --> vendor
  api --> menu
  worker --> menu
  worker --> db
  api --> admin
  api --> principal
  principal --> spaps
  api --> db
  migrations --> db
